{
    "framework": "vite",
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "installCommand": "npm install",
    "routes": [
        {
            "src": "^/api/(.*)",
            "dest": "https://ai-power-learning-assistant-server.vercel.app/api/$1"
        },
        {
            "src": "^(?!/api/).*",
            "dest": "/index.html"
        }
    ]
}